VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional — leave unset to disable analytics entirely. Get a Measurement ID from analytics.google.com.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Server-side only (no VITE_ prefix). Powers /api/matches and /api/standings — get a key at
# sportsrc.org. See api/_lib/sportsrc.js.
SPORTSRC_API_KEY=your-sportsrc-api-key

# --- PayHero (M-Pesa STK push collect and automated withdrawals) — all server-side
# only, set in Vercel's dashboard only, never committed to git.
# See api/payhero/*.js. Get these from app.payhero.co.ke -> API Keys / Payment Channels.
PAYHERO_AUTH_TOKEN=your-basic-auth-token
# Alternatively, if providing username and password separately:
# PAYHERO_API_USERNAME=your-payhero-api-username
# PAYHERO_API_PASSWORD=your-payhero-api-password

# Your linked channel ID (e.g. Paybill, Till, or Bank channel ID from PayHero dashboard)
PAYHERO_CHANNEL_ID=your-payhero-channel-id

# Base URL (default is https://backend.payhero.co.ke)
# PAYHERO_BASE_URL=https://backend.payhero.co.ke

# Optional: override callback URL sent to PayHero. Defaults to https://your-domain/api/payhero/callback
# PAYHERO_CALLBACK_URL=https://falconforecast.com/api/payhero/callback

# Any long random string — required to call /api/payhero/query-status (the reconciliation
# fallback for payments whose callback never arrived, scheduled in vercel.json). Generate
# your own with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYHERO_CRON_SECRET=a-long-random-string
# Set to the SAME value as PAYHERO_CRON_SECRET above, under this exact name — Vercel Cron
# automatically sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations only when
# a variable with this specific name exists.
CRON_SECRET=same-value-as-payhero-cron-secret
# Note: Vercel's Hobby plan only allows cron schedules that run at most once a day — a more
# frequent schedule in vercel.json doesn't get silently downgraded, it makes the WHOLE
# deployment fail outright (this actually happened: every deploy silently failed for hours
# while production kept serving a much older build). Both crons in vercel.json now run once
# daily; upgrade to Pro if you want the reconciliation jobs checking more often than that.
# Supabase Dashboard -> Settings -> API -> service_role secret (NOT the anon key). Lets the
# callback handler write payments/subscriptions with no user session, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
