VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional — leave unset to disable analytics entirely. Get a Measurement ID from analytics.google.com.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Server-side only (no VITE_ prefix). Powers /api/matches — get a free key at football-data.org.
FOOTBALL_DATA_API_KEY=your-football-data-org-api-key

# --- Pretium (M-Pesa collect/disburse) — all server-side only, set in Vercel's dashboard
# only, never committed here since this repo is public. See api/pretium/*.js.
PRETIUM_API_KEY=your-pretium-xwift-x-api-key
# Any long random string — embedded in the callback_url we send Pretium so we can verify a
# webhook request actually came from them (Pretium doesn't sign payloads). Generate your own
# with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PRETIUM_WEBHOOK_SECRET=a-long-random-string
# Supabase Dashboard -> Settings -> API -> service_role secret (NOT the anon key). Lets the
# webhook handler write payments/subscriptions with no user session, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
