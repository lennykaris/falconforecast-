VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional — leave unset to disable analytics entirely. Get a Measurement ID from analytics.google.com.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Server-side only (no VITE_ prefix). Powers /api/matches — get a free key at football-data.org.
FOOTBALL_DATA_API_KEY=your-football-data-org-api-key

# --- Kentapay (M-Pesa collect/disburse via Eclectics' "Swivel" gateway) — all server-side
# only, set in Vercel's dashboard only, never committed here since this repo is public.
# See api/kentapay/*.js. Get these from developer.kentapay.com -> Settings -> API Credentials.
KENTAPAY_CLIENT_ID=your-kentapay-client-id
KENTAPAY_USERNAME=your-kentapay-username
KENTAPAY_PASSWORD=your-kentapay-password
# Sandbox host by default — switch to Kentapay's production host (sent to you by email once
# you go live) by setting this in Vercel. Leave unset for sandbox.
# KENTAPAY_BASE_URL=https://test-eclecticsgateway.ekenya.co.ke:8095
# Service IDs — defaults match Kentapay's documented sandbox values; override only if their
# team assigned you different ones (check developer.kentapay.com -> Services).
# KENTAPAY_CHECKOUT_SERVICE_ID=5067
# KENTAPAY_B2C_SERVICE_ID=6125
# Any long random string — required to call /api/kentapay/query-status (the reconciliation
# fallback for payments whose callback never arrived). Generate your own with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KENTAPAY_CRON_SECRET=a-long-random-string
# Supabase Dashboard -> Settings -> API -> service_role secret (NOT the anon key). Lets the
# callback handler write payments/subscriptions with no user session, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
